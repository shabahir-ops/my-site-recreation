---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Card from "@/components/item/Card.astro";
import Tabs from "@/components/interactive/Tabs.astro";
import TabLink from "@/components/interactive/TabLink.astro";
import Form from "@/components/form/Form.astro";
import Input from "@/components/form/Input.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import Overlay from "@/components/media/Overlay.astro";
import team from "../assets/graphics/fintask-team.png";
import task from "../assets/graphics/fintask-task.png";
import progress from "../assets/graphics/fintask-progress.png";
import activity from "../assets/graphics/fintask-activity.png";
import check from "../assets/graphics/fintask-rating-check.png";
import sitejabber from "../assets/graphics/fintask-sitejabber.png";
import calendar from "../assets/graphics/fintask-hero-calendar.png";
import featureTasks from "../assets/graphics/fintask-feature-task-progress.png";
import featureCalendar from "../assets/graphics/fintask-feature-plan-calendar.png";
import featureCollaboration from "../assets/graphics/fintask-feature-collaborations.png";
import workflowPreview from "../assets/graphics/fintask-advantage-workflow.webp";
import projectsPreview from "../assets/graphics/fintask-advantage-projects.webp";
import integrationsPreview from "../assets/graphics/fintask-advantage-apps.webp";
import workflowIcon from "../assets/icons/advantage-workflow.svg";
import featuresIcon from "../assets/icons/advantage-features.svg";
import teamIcon from "../assets/icons/advantage-team.svg";
import statusIcon from "../assets/icons/advantage-status.svg";
import individualsIcon from "../assets/icons/plan-individuals.svg";
import eliteTeamIcon from "../assets/icons/plan-team.svg";
import startupIcon from "../assets/icons/plan-startup.svg";
import jillianBenbow from "../assets/graphics/fintask-review-jillian-benbow.png";
import pilliafTom from "../assets/graphics/fintask-review-pilliaf-tom.png";
import montesKei from "../assets/graphics/fintask-review-montes-kei.png";
import jillian from "../assets/graphics/fintask-review-jillian.png";
import jillianBenbowMac from "../assets/graphics/fintask-review-jillian-benbow-mac.png";
import entersJK from "../assets/graphics/fintask-review-enters-jk.png";
import benbow from "../assets/graphics/fintask-review-benbow.png";
import jillianBenbowTeam from "../assets/graphics/fintask-review-jillian-benbow-team.png";
import supportLeft from "../assets/graphics/fintask-support-left.png";
import supportCenter from "../assets/graphics/fintask-support-center.png";
import supportRight from "../assets/graphics/fintask-support-right.png";
import trialTopLeft from "../assets/graphics/fintask-trial-top-left.svg";
import trialBottomRight from "../assets/graphics/fintask-trial-bottom-right.svg";
import trialCheck from "../assets/icons/trial-check.svg";
import notion from "../assets/logo/notion.svg";
import googleCalendar from "../assets/logo/google-calendar.svg";
import trello from "../assets/logo/trello.svg";
import slack from "../assets/logo/slack.svg";
import outlook from "../assets/logo/outlook.svg";

const billingPeriods = ["monthly", "yearly"] as const;
const subscriptionEndpoint = import.meta.env.PUBLIC_FINTASK_SUBSCRIBE_URL?.trim();
const signupUrl = import.meta.env.PUBLIC_FINTASK_SIGNUP_URL?.trim();
const trialDetails = ["Try FREE for 14 days", "No card required", "No switching banks"];
const portraitOutline = "outline: .146rem solid var(--ft-paper); outline-offset: -.146rem;";
---

<Layout theme="fintask" title="Fintask">
  <!-- Hero -->
  <Section data-animate="onload" aria-labelledby="hero-title" paddingBottom="small" align="center">
    <ContentWrapper
      slot="background"
      data-reveal-at="0.32"
      class="fintask-callouts"
      column1Class="fintask-callouts_activity position-absolute"
      column2Class="fintask-callouts_progress position-absolute radius-none"
      style={`--_visual-ratio: ${progress.width} / ${progress.height}`}
      aria-hidden="true"
    >
      <Img src={activity} variant="densities" width={269} transparent />
      <Img slot="column2" src={progress} variant="densities" width={174} transparent />
    </ContentWrapper>
    <ContentWrapper
      centered
      column2Class="fintask-calendar margin-inline-auto"
      style="padding-top: .375rem; row-gap: clamp(3rem, 5.3vw, 4.75rem); --h1-margin-bottom: var(--space-5); --text-large-line-height: 1.3; --text-large-font-weight: var(--primary-medium);"
    >
      <Heading tag="h1" id="hero-title" aria-label="Manage Your Team’s Productivity">
        <span class="fintask-title-line" data-reveal-at="0">
          <span data-split-text>Manage Your</span>
          <button type="button" class="fintask-title-team" data-click="bounce" data-shadow-lift aria-label="Bounce the team illustration" disabled>
            <Img src={team} variant="densities" width={118} transparent loading="eager" />
          </button>
          <span data-split-text>Team’s</span>
        </span>
        <span class="fintask-title-line" data-reveal-at="0.08">
          <button type="button" class="fintask-title-task" data-click="bounce" data-shadow-lift aria-label="Bounce the task illustration" disabled>
            <Img src={task} variant="densities" width={290} transparent loading="eager" />
          </button>
          <span data-split-text style="color: var(--ft-orange)">Productivity</span>
        </span>
      </Heading>
      <Paragraph data-split-text data-reveal-at="0.16" variant="large" style="max-width: min(100%, 31.1875rem); text-box: normal; color: color-mix(in srgb, currentColor 72%, transparent);">
        Plan projects, stay on track, and deliver on time without overworking your team.
      </Paragraph>
      <ButtonWrapper data-reveal-at="0.24" marginTop="7">
        <Button data-shadow-lift="cta" variant="pill" disabled>Try Now - Free!</Button>
      </ButtonWrapper>
      <Paragraph
        data-reveal-at="0.32"
        variant="small"
        class="flex-horizontal-nowrap align-items-center margin-top-5"
        style="gap: .375rem; color: color-mix(in srgb, currentColor 80%, transparent);"
      >
        <Img src={check} variant="densities" width={16} transparent />
        Excellent 4.9 out of 5
        <Img src={sitejabber} variant="densities" width={80} transparent alt="Sitejabber" />
      </Paragraph>
      <Overlay
        data-reveal-at="0.4"
        slot="column2"
        aria-hidden="true"
        style="top: 1%; height: 98%; border-radius: var(--ft-feature-radius); background: var(--ft-hero-gradient); transform: rotate(4deg);"
      />
      <Img
        data-reveal-at="0.4"
        slot="column2"
        src={calendar}
        variant="constrained"
        width={1203}
        sizes="(min-width: 81rem) 75.2rem, 100vw"
        transparent
        class="position-relative height-auto align-self-start radius-none"
        style="width: 107.2%; max-width: none;"
        alt="Fintask project calendar with scheduled tasks, assignees, and deadlines."
      />
    </ContentWrapper>
  </Section>
  <!-- Integrations -->
  <Section data-animate="scroll"
    id="integrations"
    aria-labelledby="integrations-title"
    paddingTop="none"
    paddingBottom="small"
    align="center"
    style="padding-top: calc(var(--space-7) + .125rem); scroll-margin-top: 9rem;"
  >
    <ContentWrapper centered>
      <Heading data-split-text
        tag="h2"
        variant="inherit"
        id="integrations-title"
        style="font: 400 var(--h5)/1.35 var(--ft-action-family); color: color-mix(in srgb, currentColor 48%, transparent); text-box: normal;"
      >Our native plants are listed below&nbsp; integrations</Heading>
      <Grid
        xsmall={2}
        small={3}
        large={5}
        class="grid-tracks-content justify-content-center align-items-center gap-small gap-row-4 margin-top-6"
      >
        <Img src={notion} variant="densities" width={121} transparent alt="Notion" />
        <Img src={googleCalendar} variant="densities" width={147} transparent alt="Google Calendar" />
        <Img src={trello} variant="densities" width={162} transparent alt="Trello" />
        <Img src={slack} variant="densities" width={127} transparent alt="Slack" />
        <Img src={outlook} variant="densities" width={174} transparent alt="Microsoft Outlook" />
      </Grid>
    </ContentWrapper>
  </Section>
  <!-- Features -->
  <Section data-animate="scroll"
    id="features"
    aria-labelledby="features-title"
    paddingTop="small"
    paddingBottom="small"
    align="center"
    gap="small"
    containerAttrs={{ style: "max-width: 78.3125rem;" }}
    style="padding-top: calc(var(--section-space-small) - .5rem); scroll-margin-top: 9rem;"
  >
    <ContentWrapper centered>
      <Eyebrow variant="annotation" style="--feature-label: #cbcbcb;">Features</Eyebrow>
      <Heading data-split-text tag="h2" id="features-title" class="margin-top-2" style="text-box: normal;">
        The features<br />Both familiar and new.
      </Heading>
    </ContentWrapper>
    <Grid data-feature-lift medium={2} large={3} class="gap-small gap-row-7">
      <Card
        variant="feature"
        heading="Task Prograss"
        text="Send scheduling links guests love"
        image={featureTasks}
        imageAlt="November 15 task schedule with assigned team members"
        style="--feature-surface: var(--ft-cream); --feature-outline: #ffd15a3d; --feature-glow: #dae0001f; --feature-tilt: -8deg;"
      />
      <Card
        variant="feature"
        heading="Plan Calendar"
        text="Send scheduling links guests love"
        image={featureCalendar}
        imageAlt="Weekly calendar showing design and bug-fix tasks"
        style="--feature-surface: var(--ft-lilac); --feature-outline: color-mix(in srgb, var(--ft-violet) 16%, transparent); --feature-glow: color-mix(in srgb, var(--ft-violet) 10%, transparent); --feature-shadow: var(--ft-ink); --feature-tilt: -5deg;"
      />
      <Card
        variant="feature"
        heading="Collaborations"
        text="Send scheduling links guests love"
        image={featureCollaboration}
        imageAlt="Teammates collaborating on a UI animations task"
        style="--feature-surface: var(--ft-ice); --feature-outline: #1abcfe29; --feature-glow: #1abcfe1a; --feature-tilt: 4deg;"
      />
    </Grid>
  </Section>
  <!-- Advantages -->
  <Section data-animate="scroll"
    id="advantages"
    aria-labelledby="advantages-title"
    align="center"
    paddingTop="small"
    paddingBottom="small"
    gap="small"
    containerAttrs={{ style: "max-width: var(--ft-content-width);" }}
    style="scroll-margin-top: 9rem;"
  >
    <ContentWrapper centered>
      <Eyebrow variant="annotation" style="--annotation-accent: var(--ft-violet); --feature-label: #bcbcbc;">Advantages</Eyebrow>
      <Heading data-split-text tag="h2" id="advantages-title" class="margin-top-2" style="max-width: 18ch; text-box: normal; --h2-margin-bottom: var(--space-4);">
        A task manager you can trust for teams
      </Heading>
      <Paragraph data-split-text variant="large" style="text-box: normal;">
        Plan projects, stay on track, and deliver on time without overworking your team.
      </Paragraph>
      <ButtonWrapper marginTop="5">
        <Button data-shadow-lift="cta" element="link" variant="pill" href="#advantage-workflow">Get Start</Button>
      </ButtonWrapper>
    </ContentWrapper>
    <Grid variant="stack" class="gap-small" style="--stack-top: calc(var(--space-6) + 6.25rem); --panel-text: var(--ft-paper);">
      <ContentWrapper
        variant="panel"
        id="advantage-workflow"
        role="group"
        aria-labelledby="workflow-title"
        style="--panel-color: var(--ft-orange); --panel-ratio: 610 / 502; --panel-min-height: 36rem; scroll-margin-top: var(--stack-top);"
      >
        <Heading data-split-text tag="h3" variant="h2" id="workflow-title">Simple to use, powerful when need.</Heading>
        <Paragraph data-split-text variant="large">Create tasks and projects, upload files, and add comments. With Teamwork everything is in one central location.</Paragraph>
        <ul class="advantage-points">
          <li><Img src={workflowIcon} variant="densities" width={40} transparent /><Paragraph tag="span">Costumized your workflow.</Paragraph></li>
          <li><Img src={featuresIcon} variant="densities" width={40} transparent /><Paragraph tag="span">Extra features for complex projects.</Paragraph></li>
        </ul>
        <Img slot="column2" src={workflowPreview} variant="constrained" width={610} sizes="(min-width: 80rem) 38rem, (min-width: 48rem) 48vw, 100vw" transparent alt="Fintask project board with bug fixes, assignees and progress updates" />
      </ContentWrapper>
      <ContentWrapper
        variant="panel"
        role="group"
        aria-labelledby="projects-title"
        style="--panel-color: var(--ft-forest); --panel-ratio: 644 / 474;"
      >
        <Heading data-split-text tag="h3" variant="h2" id="projects-title">Take complex projects with ease</Heading>
        <Paragraph data-split-text variant="large">Use status features updates to see how your project is progressing and what’s left to do.</Paragraph>
        <ul class="advantage-points">
          <li><Img src={teamIcon} variant="densities" width={40} transparent /><Paragraph tag="span">Keep everyone accountable.</Paragraph></li>
          <li><Img src={statusIcon} variant="densities" width={40} transparent /><Paragraph tag="span">Make sure your status.</Paragraph></li>
        </ul>
        <Img slot="column2" src={projectsPreview} variant="constrained" width={644} sizes="(min-width: 80rem) 40rem, (min-width: 48rem) 48vw, 100vw" transparent alt="Project dashboard with progress bars, a chart, a task schedule and team cards" />
      </ContentWrapper>
      <ContentWrapper
        variant="panel"
        role="group"
        aria-labelledby="apps-title"
        style="--panel-color: var(--ft-violet); --panel-ratio: 618 / 448;"
      >
        <Heading data-split-text tag="h3" variant="h2" id="apps-title">Create calm with integrations.</Heading>
        <Paragraph data-split-text variant="large" maxWidth={43}>Connect Fintask with all the favorite tools you’ve already use.</Paragraph>
        <ButtonWrapper marginTop="5">
          <Button data-shadow-lift="cta" element="link" variant="pill" href="#integrations" style="--button-background: var(--ft-orange); --button-border: #ae3011; --shadow-depth: .4rem;">Explore integrations</Button>
        </ButtonWrapper>
        <Img slot="column2" src={integrationsPreview} variant="constrained" width={618} sizes="(min-width: 80rem) 39rem, (min-width: 48rem) 48vw, 100vw" transparent alt="Slack, Dropbox, Miro and Notion integration cards" />
      </ContentWrapper>
    </Grid>
  </Section>
  <!-- Pricing -->
  <Section data-animate="scroll"
    id="pricing"
    aria-labelledby="pricing-title"
    paddingTop="small"
    align="center"
    gap="4"
    containerAttrs={{ style: "max-width: 66.6875rem;" }}
    style="scroll-margin-top: var(--nav-height);"
  >
    <ContentWrapper centered>
      <Eyebrow variant="annotation" style="--feature-label: #bcbcbc;">Pricing</Eyebrow>
      <Heading data-split-text tag="h2" id="pricing-title" class="margin-top-2" style="max-width: 18ch; text-box: normal; --h2-margin-bottom: 0;">
        Choose a plan that fits your team.
      </Heading>
      <Paragraph id="billing-label" variant="large" class="margin-top-5" style="text-box: normal; --text-large-line-height: 1.3; --text-large-font-weight: var(--primary-medium);">
        Choose your billing
      </Paragraph>
    </ContentWrapper>
    <Tabs id="billing" variant="segmented" labelledBy="billing-label">
      <Fragment slot="links">
        <TabLink>Month</TabLink>
        <TabLink aria-describedby="yearly-savings">Yearly</TabLink>
      </Fragment>
      <span slot="note" id="yearly-savings">Save 20%</span>
      {billingPeriods.map(period => (
        <Grid medium={2} large={3} class="gap-4 gap-row-6 align-items-start" data-default-panel={period === "yearly" || undefined}>
          <Card
            variant="plan"
            heading="Individuals"
            image={individualsIcon}
            price={period === "yearly" ? "$9.99" : "$12.49"}
            billingPeriod={period}
            text="Per month"
            benefits={[
              "Unlimited projects, clients",
              "Personal desktop activity tracking",
              "Add up to 5 members to your project",
            ]}
          >
            <Button data-shadow-lift="cta" variant="pill" emphasis="secondary" disabled>Buy now</Button>
          </Card>
          <Card
            variant="plan"
            heading="Elite Team"
            image={eliteTeamIcon}
            price={period === "yearly" ? "$12.99" : "$16.24"}
            billingPeriod={period}
            text="Per month"
            trial="15-day free trial"
            featured
            benefits={[
              "Everything in Starter +",
              "Centralized control of labor costs and billable rates for team members",
              "Single sign-on (SSO)",
            ]}
          >
            <Button data-shadow-lift="cta" variant="pill" disabled>Buy now</Button>
          </Card>
          <Card
            variant="plan"
            heading="Startup"
            image={startupIcon}
            price="Contact"
            text="us to pre-order"
            benefits={[
              "Everything in Premium +",
              "Manage multiple workspaces under one organization",
              "Expert training and assistance",
            ]}
          >
            <Button data-shadow-lift="cta" slot="beforeBenefits" variant="pill" emphasis="secondary" disabled>Contact now</Button>
          </Card>
        </Grid>
      ))}
    </Tabs>
  </Section>
  <!-- Reviews -->
  <Section data-animate="scroll"
    id="reviews"
    aria-labelledby="reviews-title"
    align="center"
    paddingTop="none"
    paddingBottom="small"
    containerAttrs={{ style: "max-width: calc(3 * var(--ft-review-width) + 2 * var(--space-4)); gap: calc(var(--space-8) + .5rem);" }}
    style="--masonry-offset: 1.25rem; padding-top: calc(var(--space-5) - .25rem); scroll-margin-top: var(--nav-height);"
  >
    <ContentWrapper centered>
      <Eyebrow variant="annotation" style="--feature-label: #bcbcbc;">Reviews</Eyebrow>
      <Heading data-split-text tag="h2" id="reviews-title" class="margin-top-2" style="text-box: normal;">Loved by product people</Heading>
    </ContentWrapper>
    <Grid id="review-list" variant="masonry" data-autoplay medium={2} large={3}>
      <Card variant="review" author="Jillian Benbow" byline="Senior Community Manager" image={jillianBenbow}
        text="“Fintask The best!”" />
      <Card variant="review" author="Pilliaf Tom" byline="Senior Manager" image={pilliafTom}
        text={`“Hey Fintaskyou all did an amazing job. It's seriously saving me so much time.

- Screenshots don't 👌disappear right away
- I can draw & add arrows to screenshots instantly`} />
      <Card variant="review" author="Jillian Benbow" byline="Senior Community Manager" image={jillianBenbow}
        text="Fintask is my favourite" />
      <Card variant="review" author="Montes Kei" byline="Developer at CBN" image={montesKei}
        text="“Can't recommend Fintask enough 👌”" />
      <Card variant="review" author="Jillian" byline="Community Manager" image={jillian}
        text="“FintaskOne of *the* nicest, most wonderful, amazing, perfect Mac apps I use fifty+ times a day. Worth every penny.”"
        style="--review-role-family: var(--ft-action-family); --review-role-size: var(--text-small);" />
      <Card variant="review" author="Jillian Benbow" byline="Senior Community Manager" image={jillianBenbowMac}
        text="I'm so happy using the best screenshot/video recording app ever – Webuir. Great job guys. ✨" />
      <Card variant="review" author="Enters JK" byline="Software Eng. at Bom" image={entersJK}
        text="“I love Fintask! Use it daily too.”" />
      <Card variant="review" author="Benbow" byline="Senior Manager" image={benbow}
        text="“Have you used Fintask before? When you take a screenshot, it pops up and let's you save it or copy it. Probably one of my favorite pieces of Mac software”"
        style="--review-role-family: var(--ft-action-family); --review-role-size: var(--text-small);" />
      <Card variant="review" author="Jillian Benbow" byline="Senior Community Manager" image={jillianBenbowTeam}
        text="Fintask does anything and everything I need. 👌" />
      <Button data-shadow-lift="cta" slot="action" variant="pill" emphasis="secondary" data-expanded-label="See less"
        style="--button-2-background: var(--ft-paper); --button-2-text: var(--ft-violet-edge); --button-2-border: var(--ft-violet-edge); --ft-action-stroke: var(--ft-outline-stroke);">
        See more
      </Button>
    </Grid>
  </Section>
  <!-- Support -->
  <Section data-animate="scroll"
    id="contact"
    aria-labelledby="contact-title"
    align="center"
    paddingTop="none"
    paddingBottom="medium"
    style="padding-top: var(--space-6); scroll-margin-top: var(--nav-height);"
  >
    <ContentWrapper centered>
      <Grid class="align-items-end justify-content-center gap-0" style="grid-template-columns: 3rem 1.75rem 3rem;" aria-hidden="true">
        <Img src={supportLeft} variant="densities" width={48} transparent class="radius-round" style={portraitOutline} />
        <Img src={supportCenter} variant="densities" width={56} transparent class="radius-round" style={`${portraitOutline} max-width: none; justify-self: center; z-index: 1;`} />
        <Img src={supportRight} variant="densities" width={48} transparent class="radius-round" style={portraitOutline} />
      </Grid>
      <Heading data-split-text tag="h2" variant="h4" id="contact-title" class="margin-top-5"
        style="--h4-font-family: var(--ft-body-family); --h4-font-weight: var(--primary-medium); --h4-line-height: 1.3125; --h4-margin-bottom: 1.25rem; text-box: normal;">
        Still have questions?
      </Heading>
      <Paragraph data-split-text variant="main" style="max-width: 35.3125rem; text-box: normal; color: var(--ft-muted);">
        If you can’t find the answer to your question in our FAQ, you can always contact us. We’ll get back to you shortly.
      </Paragraph>
      <Form
        name="fintask-subscribe"
        variant="inline"
        aria-label="Email subscription"
        action={subscriptionEndpoint}
        successMessage="Thanks for subscribing!"
        errorMessage="We couldn’t complete your subscription. Please try again."
        class="margin-top-6"
      >
        <Input variant="email" name="email" label="Email address" placeholder="email address" labelHidden required disabled={!subscriptionEndpoint} />
        <Button data-shadow-lift="cta" type="submit" disabled={!subscriptionEndpoint}>Subscribe</Button>
      </Form>
      {!subscriptionEndpoint && <Paragraph variant="small" class="margin-top-2" style="color: var(--ft-muted);">Subscriptions are currently unavailable.</Paragraph>}
    </ContentWrapper>
  </Section>
  <!-- Free trial -->
  <Section data-animate="scroll"
    id="free-trial"
    aria-labelledby="free-trial-title"
    align="center"
    paddingTop="small"
    paddingBottom="medium"
    style={`
      --background: var(--ft-cream);
      background-image: url("${trialTopLeft.src}"), url("${trialBottomRight.src}");
      background-position: left top, right bottom;
      background-size: 18.75% auto, 31.9444% auto;
      background-repeat: no-repeat;
      padding-bottom: calc(var(--section-space-medium) + .25rem);
      scroll-margin-top: var(--nav-height);
    `}
  >
    <ContentWrapper centered style="--text-small-font-weight: var(--primary-medium); --text-small-line-height: 1.75;">
      <Heading data-split-text tag="h2" id="free-trial-title" style="--h2-line-height: 1.232; text-box: normal;">
        Get more<br /> productive team
      </Heading>
      <ButtonWrapper style="margin-block: calc(var(--space-6) + .25rem) calc(var(--space-5) - .25rem);">
        <Button data-shadow-lift="cta"
          variant="pill"
          {...(signupUrl ? { element: "link" as const, href: signupUrl } : { disabled: true, title: "Trial signup is currently unavailable." })}
          style="--ft-action-stroke: var(--ft-outline-stroke); --shadow-depth: .375rem;"
        >Start Now - Free</Button>
      </ButtonWrapper>
      <Grid
        medium={3}
        role="list"
        aria-label="Free trial details"
        class="grid-tracks-content justify-content-center gap-4 gap-row-2"
      >
        {trialDetails.map(detail => (
          <Paragraph role="listitem" variant="small" class="flex-horizontal-nowrap align-items-center gap-2 margin-top-0">
            <Img src={trialCheck} variant="densities" width={32} transparent />
            {detail}
          </Paragraph>
        ))}
      </Grid>
    </ContentWrapper>
  </Section>
</Layout>

<script>
  import { gsap } from "gsap";

  import { SplitText } from "gsap/SplitText";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(SplitText, ScrollTrigger);

  function revealWords(element: HTMLElement, timeline: gsap.core.Timeline, start = 0) {
    const split = SplitText.create(element, { type: "words", tag: "span" });
    timeline.from(split.words, {
      opacity: 0, yPercent: 30, duration: 0.45, ease: "power2.out",
      stagger: { amount: Math.min(0.28, split.words.length * 0.035) },
      onComplete: () => split.revert(),
    }, start);
    return split;
  }

  gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
    for (const card of document.querySelectorAll("[data-feature-lift] > .card_wrap.feature")) {
      gsap.fromTo(card, { "--feature-lift": 0 }, {
        "--feature-lift": 1,
        ease: "none",
        scrollTrigger: { trigger: card, start: "top 94%", end: "top 48%", scrub: 0.25 },
      });
    }
    for (const section of document.querySelectorAll('[data-animate="scroll"]')) {
      gsap.from(section, {
        opacity: 0.35, duration: 0.55, ease: "power2.out", clearProps: "opacity",
        scrollTrigger: { trigger: section, start: "top 95%", once: true },
      });
      for (const text of section.querySelectorAll<HTMLElement>("[data-split-text]")) {
        const timeline = gsap.timeline({
          scrollTrigger: { trigger: text, start: "top 96%", once: true },
        });
        revealWords(text, timeline);
      }
    }
  });

  const liftIn = { "--lift-load": 1, duration: 0.5, ease: "back.out(2.6)" };
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", (context) => {
    const listeners = new AbortController();
    const reveal = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        reveal.unobserve(entry.target);
        context.add(() => gsap.to(entry.target, { ...liftIn }));
      }
    });
    // Observe each CTA so controls in hidden pricing tabs lift on their first appearance.
    for (const cta of document.querySelectorAll('[data-shadow-lift="cta"]')) {
      if (cta.closest('[data-animate="onload"]')) continue;
      gsap.set(cta, { "--lift-load": 0 });
      reveal.observe(cta);
    }
    const options = { signal: listeners.signal };
    const controls = document.querySelectorAll<HTMLButtonElement>('[data-click="bounce"]');

    for (const control of controls) {
      const artwork = control.querySelector("img");
      if (!artwork) continue;
      const bounce = gsap.timeline({ paused: true })
        .to(artwork, { "--bounce-x": 1.1, "--bounce-y": 0.86, duration: 0.05 })
        .to(artwork, { "--bounce-rise": "-16px", "--bounce-x": 0.95, "--bounce-y": 1.1, duration: 0.09, ease: "power2.out" })
        .to(artwork, { "--bounce-rise": "0px", "--bounce-x": 1.07, "--bounce-y": 0.9, duration: 0.08, ease: "power2.in" })
        .to(artwork, { "--bounce-rise": "-6px", "--bounce-x": 0.98, "--bounce-y": 1.04, duration: 0.07, ease: "power2.out" })
        .to(artwork, { "--bounce-rise": "0px", "--bounce-x": 1, "--bounce-y": 1, duration: 0.11, ease: "sine.inOut" });
      control.disabled = false;
      control.addEventListener("click", () => bounce.restart(), options);
    }

    for (const button of document.querySelectorAll<HTMLElement>("[data-shadow-lift]")) {
      const hover = gsap.fromTo(button, { "--lift-hover": 0 }, {
        "--lift-hover": 0.7, paused: true, duration: 0.24, ease: "back.out(2.6)",
      });
      const update = () => {
        const hovered = window.matchMedia("(hover: hover)").matches && button.matches(":hover");
        hover.reversed(!(hovered || button.matches(":focus-visible"))).paused(false);
      };
      for (const event of ["pointerenter", "pointerleave", "focus", "blur"]) {
        button.addEventListener(event, update, options);
      }
    }

    return () => {
      reveal.disconnect();
      listeners.abort();
      for (const control of controls) control.disabled = true;
    };
  });

  if (!reducedMotion.matches) {
    for (const section of document.querySelectorAll('[data-animate="onload"]')) {
      const entrance = gsap.timeline({
        paused: true,
        defaults: { duration: 0.6, ease: "power2.out" },
        onComplete: finish,
      });

      const splits: SplitText[] = [];

      function finish() {
        reducedMotion.removeEventListener("change", finish);
        entrance.revert();
        splits.forEach(split => split.revert());
      }

      for (const item of section.querySelectorAll<HTMLElement>("[data-reveal-at]")) {
        const delay = Number(item.dataset.revealAt);
        const start = Number.isFinite(delay) ? Math.max(0, delay) : 0;
        entrance.from(item, { opacity: 0, y: 16 }, start);
        const texts = item.matches("[data-split-text]") ? [item] : item.querySelectorAll<HTMLElement>("[data-split-text]");
        for (const text of texts) splits.push(revealWords(text, entrance, start));
        const faces = item.querySelectorAll("[data-shadow-lift]");
        if (faces.length) {
          entrance.fromTo(faces, { "--lift-load": 0 }, { ...liftIn }, start);
        }
      }

      reducedMotion.addEventListener("change", finish);
      entrance.play();
    }
  }
</script>
