---
import mark from "../../assets/logo/fintask-mark.svg";
import "../../styles/fintask.css";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
  /** Destinations for the landing page navigation. */
  destinations?: Partial<Record<"pricing" | "download" | "integrations" | "join", string>>;
}
const { render = true, overlap = false, destinations = {} } = Astro.props;
const links = [
  { label: "Pricing", href: destinations.pricing ?? "/#pricing" },
  { label: "Download", href: destinations.download },
  { label: "Integrations", href: destinations.integrations ?? "/#integrations" },
];
---
{render && (
  <header class:list={["nav_wrap", overlap && "overlap"]}>
    <div class="nav_inner">
      <a class="nav_logo" href="/" aria-label="Fintask home">
        <img src={mark.src} width="40" height="40" alt="" /> Fintask
      </a>
      <button class="nav_toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
        <span class="nav_toggle_icon" aria-hidden="true"></span>
      </button>
      <nav class="nav_menu" id="nav-menu" aria-label="Main">
        <ul class="nav_links">
          {links.map(({ label, href }) => <li><a class="nav_link" href={href} aria-disabled={!href || undefined}>{label}</a></li>)}
        </ul>
        <a class="nav_join" data-shadow-lift={Astro.url.pathname === "/" ? "cta" : undefined} href={destinations.join} aria-disabled={!destinations.join || undefined}>Join Free</a>
      </nav>
    </div>
  </header>
)}
<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    window
      .matchMedia("(width >= 48rem)")
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });
  }
</script>
<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      padding: var(--space-6) var(--site-margin) 0;
      color: var(--ft-ink);
      pointer-events: none;
      &.overlap { position: fixed; inset-inline: 0; }
    }
    .nav_inner {
      position: relative;
      margin-inline: auto;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-3);
      max-width: var(--ft-nav-width);
      min-height: 4.5rem;
      padding: 0.875rem var(--space-4);
      background: var(--ft-paper);
      border-radius: var(--ft-feature-radius);
      box-shadow: 0 0.5rem 6.25rem rgb(0 0 0 / 3%);
      pointer-events: auto;
    }
    .nav_logo {
      display: inline-flex; align-items: center; gap: 0.75rem;
      font: 700 2rem/2.5rem var(--ft-heading-family);
      color: inherit; text-decoration: none;
      & img { width: 2.5rem; height: 2.5rem; }
    }
    .nav_menu { display: flex; width: 100%; flex-direction: column; gap: var(--space-3); align-items: flex-start; }
    .nav_links {
      list-style: none; display: flex; flex-direction: column; gap: var(--space-2); padding: 0; margin: 0;
      font: 400 1.125rem/1.5rem var(--ft-body-family);
    }
    .nav_link, .nav_join {
      color: inherit; text-decoration: none;
      &[href]:hover { text-decoration: underline; text-underline-offset: .2em; }
    }
    .nav_join {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 8.5rem; min-height: 3.1875rem;
      border-radius: var(--ft-button-radius); outline: .1875rem solid currentColor; outline-offset: -.09375rem;
      background: var(--ft-paper); box-shadow: .25rem .25rem 0 .09375rem currentColor;
      font: 700 1.125rem/1 var(--ft-action-family);
    }
    .nav_wrap a[href]:focus-visible, .nav_toggle:focus-visible { outline: .1875rem solid var(--ft-violet-edge); outline-offset: .3rem; }
    .nav_toggle {
      display: none; margin-inline-start: auto; align-items: center; justify-content: center;
      width: 2.75rem; height: 2.75rem; color: inherit; background: transparent; border: 0;
    }
    .nav_toggle_icon {
      width: 1.375rem; height: .625rem; border-block: .125rem solid currentColor;
    }
    @media (scripting: enabled) and (width < 48rem) {
      .nav_toggle { display: inline-flex; }
      .nav_wrap:not(.open) .nav_menu { display: none; }
    }
    @media (width >= 48rem) {
      .nav_inner { flex-wrap: nowrap; min-height: 5.5625rem; gap: clamp(2rem, 5.56vw, 5rem); padding-inline: 1.5rem; }
      .nav_menu { flex: 1; width: auto; flex-direction: row; justify-content: space-between; align-items: center; }
      .nav_links { flex-direction: row; gap: 2rem; }
    }
  }
</style>
