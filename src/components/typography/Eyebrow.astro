---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** HTML element. */
  tag?: "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Eyebrow style. */
  variant?: "default" | "tag" | "annotation";
};

const {
  render = true,
  tag: Tag = "p",
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{render && content && (
  <div
    class:list={["eyebrow_wrap", variant !== "default" && variant, className]}
    {...rest}
  >
    {variant !== "tag" && (
      <span class="eyebrow_marker" aria-hidden="true" />
    )}
    <Tag class="eyebrow_text text-style-small">
      <Fragment set:html={content} />
    </Tag>
  </div>
)}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: var(--space-2);

      &.tag {
        background-color: var(--text);
        color: var(--background);
        padding: var(--space-1) var(--space-2);
        border-radius: var(--radius-small);
      }
      &.annotation {
        gap: .25rem;
        & .eyebrow_marker {
          width: 1rem;
          height: 1rem;
          border: .125rem solid var(--annotation-accent, var(--ft-orange, var(--heading-accent)));
          background: color-mix(in srgb, var(--annotation-accent, var(--ft-orange, var(--heading-accent))) 8%, transparent);
          border-radius: 50%;
        }
        & .eyebrow_text {
          font: 400 var(--h4)/1.25 var(--ft-note-family, var(--primary-family));
          letter-spacing: var(--ft-note-tracking, normal);
          text-decoration: line-through;
          text-box: normal;
          color: var(--feature-label, var(--text-2));
        }
      }
      .eyebrow_marker {
        flex: none;
        width: var(--border-width);
        height: 0.75rem;
        background-color: currentcolor;
      }
    }
  }
</style>
