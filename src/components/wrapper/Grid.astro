---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";

type Base = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
};

type Props = Base &
  (
    | {
        /** Grid mode. */
        variant?: "columns" | "masonry";
        /**
         * Columns below 30rem. Defaults to `1`.
         *
         * @min 1
         * @max 12
         * @int
         */
        xsmall?: number;
        /**
         * Columns from 30rem. Inherits `xsmall`.
         *
         * @min 1
         * @max 12
         * @int
         */
        small?: number;
        /**
         * Columns from 48rem. Inherits `small`.
         *
         * @min 1
         * @max 12
         * @int
         */
        medium?: number;
        /**
         * Columns from 64rem. Inherits `medium`.
         *
         * @min 1
         * @max 12
         * @int
         */
        large?: number;
        maxColumnCount?: never;
        minColumnWidth?: never;
      }
    | {
        variant: "stack";
        xsmall?: never;
        small?: never;
        medium?: never;
        large?: never;
        maxColumnCount?: never;
        minColumnWidth?: never;
      }
    | {
        variant: "autofit" | "autofill";
        /**
         * Maximum columns. Defaults to `12`.
         *
         * @min 1
         * @max 12
         * @int
         */
        maxColumnCount?: number;
        /** Minimum column width in rem. Defaults to `12`.
         *
         * @min 1 */
        minColumnWidth?: number;
        xsmall?: never;
        small?: never;
        medium?: never;
        large?: never;
      }
  );

type AllProps = Base & {
  variant?: "columns" | "autofit" | "autofill" | "stack" | "masonry";
  xsmall?: number;
  small?: number;
  medium?: number;
  large?: number;
  maxColumnCount?: number;
  minColumnWidth?: number;
};

const {
  render = true,
  variant = "columns",
  xsmall = 1,
  small,
  medium,
  large,
  maxColumnCount,
  minColumnWidth,
  class: className,
  ...rest
} = Astro.props as AllProps;

const content = await slotContent(Astro.slots);
const action = variant === "masonry" ? await slotContent(Astro.slots, "action") : "";

const validMinColumnWidth =
  minColumnWidth !== undefined &&
  Number.isFinite(minColumnWidth) &&
  minColumnWidth > 0;

if (
  import.meta.env.DEV &&
  minColumnWidth !== undefined &&
  !validMinColumnWidth
) {
  console.warn(
    `[lumos] <Grid minColumnWidth={${minColumnWidth}}> must be greater than 0; the default is used instead.`,
  );
}

const columns =
  (variant !== "columns" && variant !== "masonry"
    ? [
        maxColumnCount !== undefined && `--_max-cols: ${maxColumnCount}`,
        validMinColumnWidth && `--_min-col-width: ${minColumnWidth}`,
      ]
    : [
        xsmall !== 1 && `--_cols-xs: ${xsmall}`,
        small !== undefined && `--_cols-sm: ${small}`,
        medium !== undefined && `--_cols-md: ${medium}`,
        large !== undefined && `--_cols-lg: ${large}`,
      ]
  )
    .filter(Boolean)
    .join("; ") || undefined;
---

{render && content && (
  <div
    class:list={["grid", variant !== "columns" && variant, className]}
    style={columns}
    {...rest}
  >
    {variant === "masonry" ? (
      <>
        <div class="grid_viewport" id={action ? `${rest.id ?? crypto.randomUUID()}-items` : undefined}>
          <div class="grid_items"><Fragment set:html={content} /></div>
        </div>
        {action && <ButtonWrapper marginTop="0" data-grid-action hidden><Fragment set:html={action} /></ButtonWrapper>}
      </>
    ) : <Fragment set:html={content} />}
  </div>
)}

<script>
  for (const grid of document.querySelectorAll<HTMLElement>(".grid.masonry")) {
    const viewport = grid.querySelector<HTMLElement>(":scope > .grid_viewport");
    const action = grid.querySelector<HTMLElement>(":scope > [data-grid-action]");
    const button = action?.querySelector<HTMLButtonElement>("button[data-expanded-label]");
    const label = button?.querySelector<HTMLElement>(".button_text");
    if (!viewport || !action || !button || !label) continue;
    const collapsedLabel = label.textContent.trim();
    const expandedLabel = button.dataset.expandedLabel!;
    if (grid.hasAttribute("data-autoplay")) {
      const items = viewport.querySelector<HTMLElement>(".grid_items")!;
      const copy = items.cloneNode(true) as HTMLElement;
      copy.inert = true;
      copy.setAttribute("aria-hidden", "true");
      for (const el of copy.querySelectorAll("[id]")) el.removeAttribute("id");
      viewport.append(copy);
    }
    button.setAttribute("aria-controls", viewport.id);
    button.setAttribute("aria-expanded", "false");
    grid.classList.add("collapsed");
    action.hidden = false;
    button.addEventListener("click", () => {
      const collapsed = grid.classList.toggle("collapsed");
      button.setAttribute("aria-expanded", String(!collapsed));
      label.textContent = collapsed ? collapsedLabel : expandedLabel;
      if (collapsed) button.scrollIntoView({ block: "nearest" });
    });
  }

  for (const stack of document.querySelectorAll<HTMLElement>(".grid.stack")) {
    // Let a tall card scroll fully into view before it sticks.
    const observer = new ResizeObserver(entries => {
      for (const entry of entries) {
        (entry.target as HTMLElement).style.setProperty("--stack-height", `${entry.borderBoxSize[0].blockSize}px`);
      }
    });
    [...stack.children].forEach((child, index) => {
      if (!(child instanceof HTMLElement)) return;
      child.style.setProperty("--stack-index", String(index));
      observer.observe(child);
    });
  }
</script>

<style is:global>
  @layer components {
    .grid {
      --_cols: var(--_cols-xs);
      --_cols-xs: 1;
      --_cols-sm: var(--_cols-xs);
      --_cols-md: var(--_cols-sm);
      --_cols-lg: var(--_cols-md);
      --_gap-size: var(--site-gutter);
      width: 100%;
      display: grid;
      grid-column-gap: var(--_gap-size);
      grid-row-gap: var(--_gap-size);
      grid-template-columns: repeat(var(--_cols), minmax(0, 1fr));
      @media (width >= 30rem) {
        --_cols: var(--_cols-sm);
      }
      @media (width >= 48rem) {
        --_cols: var(--_cols-md);
      }
      @media (width >= 64rem) {
        --_cols: var(--_cols-lg);
      }
      &.stack {
        isolation: isolate;
        grid-auto-rows: 1fr;
        & > * {
          position: sticky;
          top: min(
            calc(var(--stack-top, var(--nav-height)) + var(--stack-index, 0) * .625rem),
            calc(100svh - var(--stack-height, 0rem) - .75rem)
          );
        }
        @media (prefers-reduced-motion: reduce) {
          & > * { position: relative; top: auto; }
        }
      }
      &.masonry {
        grid-template-columns: minmax(0, 1fr);
        row-gap: var(--space-6);
        overflow-anchor: none;
        & > [data-grid-action][hidden] { display: none; }
        & .grid_items {
          column-count: var(--_cols);
          column-gap: var(--space-4);
          & > * {
            break-inside: avoid;
            margin-block-end: var(--space-4);
          }
        }
        & .grid_viewport {
          margin-block-end: calc(-1 * var(--space-4));
          @media (width >= 64rem) { translate: var(--masonry-offset, 0) 0; }
        }
        &.collapsed > .grid_viewport {
          max-height: 35rem;
          overflow: clip;
          mask-image: linear-gradient(to bottom, black 24%, rgb(0 0 0 / 20%) 68%, transparent);
          @media (width >= 64rem) { max-height: 57rem; }
        }
        &[data-autoplay] {
          & .grid_items[inert] { display: none; }
          &.collapsed > .grid_viewport {
            mask-image: linear-gradient(to bottom, transparent, black 5%, black 95%, transparent);
            @media (prefers-reduced-motion: no-preference) {
              display: grid;
              grid-template: max-content / minmax(0, 1fr);
              & > .grid_items {
                grid-area: 1 / 1;
                animation: masonry-loop 90s linear infinite;
                @media (width >= 48rem) { animation-duration: 52s; }
                @media (width >= 64rem) { animation-duration: 38s; }
              }
              & > .grid_items[inert] {
                display: block;
                transform: translateY(100%);
              }
              &:focus-within > .grid_items { animation-play-state: paused; }
              @media (hover: hover) {
                &:hover > .grid_items { animation-play-state: paused; }
              }
            }
          }
        }
      }
      &:is(.autofit, .autofill) {
        --_max-cols: 12;
        --_min-col-width: 12;
        --_fit: calc(
          (100% - (var(--_max-cols) - 1) * var(--_gap-size)) / var(--_max-cols)
        );
        --_track: min(
          max(calc(var(--_min-col-width) * 1rem), var(--_fit)),
          100%
        );
      }
      &.autofit {
        grid-template-columns: repeat(auto-fit, minmax(var(--_track), 1fr));
      }
      &.autofill {
        grid-template-columns: repeat(auto-fill, minmax(var(--_track), 1fr));
      }
    }
    @keyframes masonry-loop {
      to { translate: 0 -100%; }
    }
  }
</style>
